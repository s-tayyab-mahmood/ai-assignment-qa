# Copy to .env for local runs. Never commit .env.
# All values here are non-secret defaults except AI_API_KEY.

BASE_URL=https://automationexercise.com
# Keep low: this is a shared public practice site.
WORKERS=2
# Block third-party ad/consent scripts (strongly recommended; see docs/test-strategy.md).
BLOCK_ADS=true

# Optional: enables the AI step of RCA. Without it, a deterministic model-free summary is produced.
# github-models (default, free; key = a GitHub token with models:read) or anthropic (paid API key).
AI_PROVIDER=github-models
# Defaults: openai/gpt-4.1 for github-models, claude-sonnet-5-5 for anthropic.
AI_MODEL=
AI_API_KEY=
# Hard cap on failures sent to the model per run (cost/latency control).
AI_MAX_FAILURES=5
